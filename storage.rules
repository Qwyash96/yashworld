rules_version = '2';

// seller-kyc/{uid}/{fileName} — KYC documents (Aadhaar/PAN/selfie/bank proof/
// GST). Only the owner can read or write their own files; admins never read
// them directly through these rules — they go through the signed-URL route
// at app/api/admin/sellers/[uid]/documents/[docKey] (Admin SDK, bypasses
// Storage rules entirely), same pattern as the staff Admin SDK routes.
// product-images/{uid}/{uuid}.{ext} — seller-uploaded product photos.
// Unlike KYC docs these are public storefront assets, so read is open to
// everyone; write stays owner-only, matching the KYC pattern. Which uid may
// actually have live products is enforced separately by firestore.rules'
// isApprovedSeller() on the products collection itself — a non-seller
// uploading an orphan file to their own uid folder has no cross-user impact.
service firebase.storage {
  match /b/{bucket}/o {
    match /seller-kyc/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    match /product-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Every other image-upload surface in the app shares one shape: public
    // read, owner-only write, image-only, 10MB cap — banner-images,
    // category-images, seller-logos, seller-banners, profile-photos,
    // support-images, coupon-banners, site-branding, review-images,
    // ad-creatives (see types/media.ts MEDIA_FOLDERS, the single source of
    // truth this list must stay in sync with). Real access control for
    // what an uploaded file is actually USED as lives at the Firestore
    // layer (e.g. banners/{id} and sponsoredAds/{id} are Admin-SDK-write-
    // only) — a non-admin uploading an orphan file to their own uid folder
    // here has no cross-user impact, identical reasoning to product-images
    // above.
    match /{folder}/{uid}/{fileName} {
      allow read: if true;
      allow write: if folder in [
          'banner-images', 'category-images', 'seller-logos', 'seller-banners',
          'profile-photos', 'support-images', 'coupon-banners', 'site-branding',
          'review-images', 'ad-creatives'
        ]
        && request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if folder in [
          'banner-images', 'category-images', 'seller-logos', 'seller-banners',
          'profile-photos', 'support-images', 'coupon-banners', 'site-branding',
          'review-images', 'ad-creatives'
        ]
        && request.auth != null && request.auth.uid == uid;
    }
  }
}
